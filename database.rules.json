{
 "rules": {
  ".read": false,
  ".write": false,
  "admins": {
   "$uid": {
    ".read": "auth.uid===$uid",
    ".write": false
   }
  },
  "users": {
   ".read": "root.child('admins').child(auth.uid).val()===true",
   "$uid": {
    ".read": "auth.uid===$uid || root.child('admins').child(auth.uid).val()===true",
    ".write": "auth.uid===$uid || root.child('admins').child(auth.uid).val()===true",
    ".validate": "newData.hasChildren(['name','email','refCode','createdAt']) && ((!data.child('email').exists() || newData.child('email').val()===data.child('email').val()) && (!data.child('refCode').exists() || newData.child('refCode').val()===data.child('refCode').val()) && (!data.child('createdAt').exists() || newData.child('createdAt').val()===data.child('createdAt').val()) && (data.child('createdAt').exists() || newData.child('createdAt').val()===now))",
    "name": {
     ".validate": "newData.isString() && newData.val().length>=2 && newData.val().length<=60"
    },
    "email": {
     ".validate": "newData.isString() && newData.val().length>=0 && newData.val().length<=120"
    },
    "avatar": {
     ".validate": "newData.isString() && newData.val().length>=1 && newData.val().length<=16"
    },
    "language": {
     ".validate": "newData.val()==='hi' || newData.val()==='en'"
    },
    "refCode": {
     ".validate": "newData.isString() && newData.val().length>=4 && newData.val().length<=12"
    },
    "createdAt": {
     ".validate": "newData.isNumber()"
    },
    "$other": {
     ".validate": false
    }
   }
  },
  "refCodes": {
   "$code": {
    ".read": "auth!=null",
    ".write": "auth!=null && !data.exists() && newData.val()===auth.uid && root.child('users').child(auth.uid).child('refCode').val()===$code",
    ".validate": "newData.isString()"
   }
  },
  "referralClaims": {
   "$uid": {
    ".read": "auth.uid===$uid || root.child('admins').child(auth.uid).val()===true",
    ".write": "(auth.uid===$uid && !data.exists()) || root.child('admins').child(auth.uid).val()===true",
    ".validate": "newData.hasChildren(['code','ts']) && newData.child('code').isString() && newData.child('ts').isNumber()"
   }
  },
  "referrals": {
   ".read": "root.child('admins').child(auth.uid).val()===true",
   "$ref": {
    ".read": "auth.uid===$ref || root.child('admins').child(auth.uid).val()===true",
    "$uid": {
     ".write": "(auth.uid===$uid && $ref!==$uid && !data.exists() && !root.child('referralClaims').child($uid).exists() && newData.child('status').val()==='pending' && root.child('refCodes').child(newData.child('code').val()).val()===$ref && newData.child('ts').val()===now) || root.child('admins').child(auth.uid).val()===true",
     ".validate": "newData.hasChildren(['code','status','ts']) && (newData.child('status').val()==='pending'||newData.child('status').val()==='verified'||newData.child('status').val()==='rewarded'||newData.child('status').val()==='rejected')"
    }
   }
  },
  "wallets": {
   "$uid": {
    ".read": "auth.uid===$uid || root.child('admins').child(auth.uid).val()===true",
    ".write": "root.child('admins').child(auth.uid).val()===true"
   }
  },
  "coinLedger": {
   "$uid": {
    ".read": "auth.uid===$uid || root.child('admins').child(auth.uid).val()===true",
    ".write": "root.child('admins').child(auth.uid).val()===true",
    ".indexOn": [
     "ts"
    ]
   }
  },
  "tasks": {
   ".read": "auth!=null",
   ".write": "root.child('admins').child(auth.uid).val()===true",
   ".indexOn": [
    "status"
   ]
  },
  "leaderboard": {
   ".read": "auth!=null",
   ".write": "root.child('admins').child(auth.uid).val()===true",
   ".indexOn": [
    "points"
   ]
  },
  "appSettings": {
   ".read": "auth!=null",
   ".write": "root.child('admins').child(auth.uid).val()===true"
  },
  "announcements": {
   ".read": "auth!=null",
   ".write": "root.child('admins').child(auth.uid).val()===true",
   ".indexOn": [
    "ts"
   ]
  },
  "notifications": {
   "$uid": {
    ".read": "auth.uid===$uid || root.child('admins').child(auth.uid).val()===true",
    ".write": "root.child('admins').child(auth.uid).val()===true",
    ".indexOn": [
     "ts"
    ]
   }
  },
  "notificationReads": {
   "$uid": {
    ".read": "auth.uid===$uid",
    "$nid": {
     ".write": "auth.uid===$uid",
     ".validate": "newData.val()===true && $nid.length<=60"
    }
   }
  },
  "submissionActive": {
   "$uid": {
    ".read": "auth.uid===$uid || root.child('admins').child(auth.uid).val()===true",
    "$tid": {
     ".write": "(auth.uid===$uid && !data.exists()) || root.child('admins').child(auth.uid).val()===true",
     ".validate": "newData.isString() && newData.val().length>=1 && newData.val().length<=60"
    }
   }
  },
  "submissions": {
   ".read": "root.child('admins').child(auth.uid).val()===true",
   "$uid": {
    ".read": "auth.uid===$uid || root.child('admins').child(auth.uid).val()===true",
    "$sid": {
     ".write": "(auth.uid===$uid && !data.exists() && newData.child('status').val()==='pending' && newData.child('ts').val()===now && !newData.child('reason').exists() && !newData.child('reviewedBy').exists() && !root.child('submissionActive').child($uid).child(newData.child('taskId').val()).exists() && root.child('tasks').child(newData.child('taskId').val()).child('status').val()==='active') || root.child('admins').child(auth.uid).val()===true",
     ".validate": "newData.hasChildren(['taskId','status','ts']) && (newData.child('status').val()==='pending'||newData.child('status').val()==='approved'||newData.child('status').val()==='rejected')",
     "taskId": {
      ".validate": "newData.isString() && newData.val().length>=1 && newData.val().length<=60"
     },
     "status": {
      ".validate": "newData.isString()"
     },
     "ts": {
      ".validate": "newData.isNumber()"
     },
     "note": {
      ".validate": "newData.isString() && newData.val().length>=0 && newData.val().length<=500"
     },
     "proofImage": {
      ".validate": "newData.isString() && newData.val().length<=220000 && newData.val().beginsWith('data:image/jpeg;base64,')"
     },
     "reason": {
      ".validate": "newData.isString() && newData.val().length>=0 && newData.val().length<=300"
     },
     "reviewedBy": {
      ".validate": "newData.isString()"
     },
     "reviewedAt": {
      ".validate": "newData.isNumber()"
     },
     "$other": {
      ".validate": false
     }
    }
   }
  },
  "deletionRequests": {
   "$uid": {
    ".read": "auth.uid===$uid || root.child('admins').child(auth.uid).val()===true",
    ".write": "(auth.uid===$uid && !data.exists()) || root.child('admins').child(auth.uid).val()===true",
    ".validate": "newData.isNumber()"
   }
  },
  "withdrawalActive": {
   "$uid": {
    ".read": "auth.uid===$uid || root.child('admins').child(auth.uid).val()===true",
    ".write": "(auth.uid===$uid && !data.exists()) || root.child('admins').child(auth.uid).val()===true",
    ".validate": "newData.isString() && newData.val().length>=1 && newData.val().length<=30"
   }
  },
  "withdrawals": {
   ".read": "root.child('admins').child(auth.uid).val()===true",
   "$uid": {
    ".read": "auth.uid===$uid || root.child('admins').child(auth.uid).val()===true",
    "$id": {
     ".write": "(auth.uid===$uid && !data.exists() && newData.child('status').val()==='requested' && !root.child('withdrawalActive').child($uid).exists() && root.child('appSettings').child('coinToRupee').val()>0 && newData.child('rate').val()===root.child('appSettings').child('coinToRupee').val() && newData.child('amount').val()>=root.child('appSettings').child('minWithdraw').val() && newData.child('amount').val()<=root.child('wallets').child($uid).child('taskCoins').val() && newData.child('ts').val()===now) || root.child('admins').child(auth.uid).val()===true",
     ".validate": "newData.hasChildren(['amount','upi','name','status','rate','ts']) && newData.child('amount').isNumber() && newData.child('amount').val()>=1 && newData.child('amount').val()%1===0 && newData.child('upi').isString() && newData.child('upi').val().matches(/^[a-zA-Z0-9._-]{2,64}@[a-zA-Z]{2,32}$/) && newData.child('name').isString() && newData.child('name').val().length>=2 && newData.child('name').val().length<=60 && (newData.child('status').val()==='requested'||newData.child('status').val()==='approved'||newData.child('status').val()==='paid'||newData.child('status').val()==='rejected')",
     "amount": {
      ".validate": true
     },
     "upi": {
      ".validate": true
     },
     "name": {
      ".validate": true
     },
     "status": {
      ".validate": true
     },
     "rate": {
      ".validate": true
     },
     "ts": {
      ".validate": true
     },
     "reason": {
      ".validate": "newData.isString() && newData.val().length>=0 && newData.val().length<=300"
     },
     "txnRef": {
      ".validate": "newData.isString() && newData.val().length>=0 && newData.val().length<=80"
     },
     "reviewedBy": {
      ".validate": "newData.isString()"
     },
     "approvedAt": {
      ".validate": "newData.isNumber()"
     },
     "paidAt": {
      ".validate": "newData.isNumber()"
     },
     "$other": {
      ".validate": false
     }
    }
   }
  }
 }
}